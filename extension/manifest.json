{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "1.0.0",
  "description": "Detects videos on the page in the background and downloads them with the right cookies and Referer.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["webRequest", "downloads", "storage", "declarativeNetRequestWithHostAccess", "offscreen"],
  "host_permissions": ["<all_urls>"]
}
